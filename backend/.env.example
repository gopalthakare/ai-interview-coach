# JWT signing key — generate any long random string
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite by default; swap to Postgres with postgresql+psycopg://...
DATABASE_URL=sqlite:///./interview_coach.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AI provider: openai | gemini | mock
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Uploads
UPLOAD_DIR=./uploads